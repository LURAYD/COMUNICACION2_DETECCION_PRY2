+        raise ValueError("Los bits deben ser 0 o 1.")
+    if bits.size % bits_per_symbol:
+        raise ValueError(f"La cantidad de bits debe ser múltiplo de {bits_per_symbol}.")
+    return bits.astype(np.int64)
